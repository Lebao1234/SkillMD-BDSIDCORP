<style>
[data-section-name="hadal-specs"] .hs{background:var(--cream);border-top:1px solid var(--line);border-bottom:1px solid var(--line);}
[data-section-name="hadal-specs"] .hs__eyebrow{color:var(--accent);font-family:var(--font-mono);font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;margin:0 0 8px;}
[data-section-name="hadal-specs"] .hs__title{font-family:var(--font-display);font-size:clamp(26px,3.4vw,38px);letter-spacing:-.025em;margin:0 0 34px;color:var(--ink);}
[data-section-name="hadal-specs"] .hs__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:26px;}
[data-section-name="hadal-specs"] .hs__chip{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:var(--radius);background:var(--paper);border:1px solid var(--line-2);color:var(--accent);margin-bottom:14px;}
[data-section-name="hadal-specs"] .hs__item b{display:block;font-family:var(--font-display);font-size:17px;color:var(--ink);margin-bottom:7px;letter-spacing:-.01em;}
[data-section-name="hadal-specs"] .hs__item p{color:var(--ink-2);font-size:14px;line-height:1.6;margin:0;}
@media (max-width:980px){[data-section-name="hadal-specs"] .hs__grid{grid-template-columns:1fr 1fr;gap:24px;}}
@media (max-width:560px){[data-section-name="hadal-specs"] .hs__grid{grid-template-columns:1fr;}}
</style>
<section class="hs py-section">
  <div class="be-wrap">
    <p class="hs__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="hs__title">{{ section.settings.heading }}</h2>
    <div class="hs__grid">
      {% for block in section.blocks %}
        <div class="hs__item" data-anim {{ block.shopify_attributes }}>
          <span class="hs__chip">{% render 'icon', name: block.settings.icon, size: 20 %}</span>
          <b>{{ block.settings.title }}</b>
          <p>{{ block.settings.body }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "blocks": [
    {
      "type": "item",
      "name": "Cam kết",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Tên icon Lucide",
          "default": "gauge"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Tiêu đề",
          "default": "Đo tại bàn thử"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Nội dung",
          "default": "Mỗi thông số công bố đều lấy từ mẫu thử thật, không sao chép từ nhà cung cấp."
        }
      ]
    }
  ],
  "category": "text",
  "name": "HADAL cam kết",
  "presets": [
    {
      "name": "HADAL cam kết"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Vì sao HADAL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Tiêu đề",
      "default": "Số liệu trước, lời quảng cáo sau"
    },
    {
      "type": "header",
      "label": "Style"
    },
    {
      "type": "checkbox",
      "id": "visible",
      "label": "Visible",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "text",
      "id": "padding_top",
      "label": "Padding top (CSS)"
    },
    {
      "type": "text",
      "id": "padding_bottom",
      "label": "Padding bottom (CSS)"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "default": 0,
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "default": 0,
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px"
    }
  ]
}
{% endschema %}
