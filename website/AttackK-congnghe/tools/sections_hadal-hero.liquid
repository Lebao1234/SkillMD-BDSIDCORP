<style>
[data-section-name="hadal-hero"] .hh{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center;}
[data-section-name="hadal-hero"] .hh__eyebrow{color:var(--accent);font-family:var(--font-mono);font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;}
[data-section-name="hadal-hero"] .hh__title{font-family:var(--font-display);font-size:clamp(38px,5.6vw,68px);line-height:1.02;letter-spacing:-.035em;margin:16px 0 18px;color:var(--ink);}
[data-section-name="hadal-hero"] .hh__sub{color:var(--ink-2);font-size:17px;line-height:1.65;max-width:52ch;margin:0 0 30px;}
[data-section-name="hadal-hero"] .hh__cta{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:40px;}
[data-section-name="hadal-hero"] .hh__stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;border-top:1px solid var(--line);padding-top:24px;}
[data-section-name="hadal-hero"] .hh__stat b{display:block;font-family:var(--font-display);font-size:26px;letter-spacing:-.02em;color:var(--ink);}
[data-section-name="hadal-hero"] .hh__stat span{display:block;color:var(--mute);font-size:12.5px;margin-top:4px;line-height:1.4;}
[data-section-name="hadal-hero"] .hh__stage{position:relative;border:1px solid var(--line-2);border-radius:var(--radius-lg);background:var(--cream);padding:34px;overflow:hidden;}
[data-section-name="hadal-hero"] .hh__stage::before{content:"";position:absolute;inset:-40% 30% 55% -30%;background:radial-gradient(closest-side,var(--accent),transparent);opacity:.22;pointer-events:none;}
[data-section-name="hadal-hero"] .hh__stage img{position:relative;display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:contain;}
@media (max-width:900px){
  [data-section-name="hadal-hero"] .hh{grid-template-columns:1fr;gap:34px;}
  [data-section-name="hadal-hero"] .hh__stats{gap:14px;}
}
</style>
<section class="py-section">
  <div class="be-wrap hh">
    <div>
      <p class="hh__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="hh__title">{{ section.settings.heading }}</h1>
      <p class="hh__sub">{{ section.settings.sub }}</p>
      <div class="hh__cta">
        {% if section.settings.cta_label != blank %}<a class="be-btn" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>{% endif %}
        {% if section.settings.cta2_label != blank %}<a class="be-btn be-btn--ghost" href="{{ section.settings.cta2_url }}">{{ section.settings.cta2_label }}</a>{% endif %}
      </div>
      <div class="hh__stats">
        <div class="hh__stat"><b>{{ section.settings.stat1_value }}</b><span>{{ section.settings.stat1_label }}</span></div>
        <div class="hh__stat"><b>{{ section.settings.stat2_value }}</b><span>{{ section.settings.stat2_label }}</span></div>
        <div class="hh__stat"><b>{{ section.settings.stat3_value }}</b><span>{{ section.settings.stat3_label }}</span></div>
      </div>
    </div>
    <div class="hh__stage" data-anim>
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image }}" alt="{{ section.settings.heading | escape }}" width="720" height="540" loading="eager">
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "category": "hero",
  "name": "HADAL hero",
  "presets": [
    {
      "name": "HADAL hero"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Thiết bị cho vùng sâu nhất"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Tiêu đề",
      "default": "Đo trước khi tin."
    },
    {
      "type": "textarea",
      "id": "sub",
      "label": "Mô tả",
      "default": "Chuột dưới 40g, bàn phím từ tính có rapid trigger và phụ kiện dựng cho độ chính xác lặp lại. Mỗi thông số trên trang này đều đo được."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Nút chính",
      "default": "Xem chuột chơi game"
    },
    {
      "type": "text",
      "id": "cta_url",
      "label": "Link nút chính",
      "default": "/collections/chuot-choi-game"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Nút phụ",
      "default": "Bàn phím từ tính HE"
    },
    {
      "type": "text",
      "id": "cta2_url",
      "label": "Link nút phụ",
      "default": "/collections/ban-phim-he"
    },
    {
      "type": "image",
      "id": "image",
      "label": "Ảnh sản phẩm",
      "default": "/storage/store-172/hadal-home/1789459280926892362-x11ultra-c06ultra-3.png"
    },
    {
      "type": "text",
      "id": "stat1_value",
      "label": "Số liệu 1",
      "default": "39g"
    },
    {
      "type": "text",
      "id": "stat1_label",
      "label": "Nhãn số liệu 1",
      "default": "Trọng lượng nhẹ nhất"
    },
    {
      "type": "text",
      "id": "stat2_value",
      "label": "Số liệu 2",
      "default": "8000Hz"
    },
    {
      "type": "text",
      "id": "stat2_label",
      "label": "Nhãn số liệu 2",
      "default": "Tần số quét tối đa"
    },
    {
      "type": "text",
      "id": "stat3_value",
      "label": "Số liệu 3",
      "default": "0,02mm"
    },
    {
      "type": "text",
      "id": "stat3_label",
      "label": "Nhãn số liệu 3",
      "default": "Bước chỉnh hành trình"
    },
    {
      "type": "header",
      "label": "Style"
    },
    {
      "type": "checkbox",
      "id": "visible",
      "label": "Visible",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "text",
      "id": "padding_top",
      "label": "Padding top (CSS)"
    },
    {
      "type": "text",
      "id": "padding_bottom",
      "label": "Padding bottom (CSS)"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "default": 0,
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "default": 0,
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px"
    }
  ]
}
{% endschema %}
