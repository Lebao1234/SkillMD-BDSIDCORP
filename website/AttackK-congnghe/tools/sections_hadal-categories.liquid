<style>
[data-section-name="hadal-categories"] .hc__head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:26px;}
[data-section-name="hadal-categories"] .hc__eyebrow{color:var(--accent);font-family:var(--font-mono);font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;margin:0 0 8px;}
[data-section-name="hadal-categories"] .hc__title{font-family:var(--font-display);font-size:clamp(26px,3.4vw,38px);letter-spacing:-.025em;margin:0;color:var(--ink);}
[data-section-name="hadal-categories"] .hc__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;}
[data-section-name="hadal-categories"] .hc__tile{display:block;border:1px solid var(--line-2);border-radius:var(--radius-lg);background:var(--cream);padding:24px;transition:border-color .2s ease,background-color .2s ease,transform .2s ease;}
[data-section-name="hadal-categories"] .hc__tile:hover{border-color:var(--accent);background:var(--cream-2);transform:translateY(-2px);color:var(--ink);}
[data-section-name="hadal-categories"] .hc__tile b{display:block;font-family:var(--font-display);font-size:19px;letter-spacing:-.015em;color:var(--ink);margin-bottom:6px;}
[data-section-name="hadal-categories"] .hc__tile span{display:block;color:var(--mute);font-size:13.5px;line-height:1.5;}
[data-section-name="hadal-categories"] .hc__tile em{display:inline-block;margin-top:14px;color:var(--accent);font-style:normal;font-size:13px;font-weight:600;}
@media (max-width:900px){[data-section-name="hadal-categories"] .hc__grid{grid-template-columns:1fr 1fr;}}
@media (max-width:560px){[data-section-name="hadal-categories"] .hc__grid{grid-template-columns:1fr;}}
</style>
<section class="py-section">
  <div class="be-wrap">
    <div class="hc__head">
      <div>
        <p class="hc__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="hc__title">{{ section.settings.heading }}</h2>
      </div>
    </div>
    <div class="hc__grid">
      {% for block in section.blocks %}
        <a class="hc__tile" href="{{ block.settings.url }}" data-anim {{ block.shopify_attributes }}>
          <b>{{ block.settings.title }}</b>
          <span>{{ block.settings.meta }}</span>
          <em>{{ section.settings.tile_cta }}</em>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "blocks": [
    {
      "type": "tile",
      "name": "Ô danh mục",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tên",
          "default": "Chuột chơi game"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Mô tả ngắn",
          "default": "Từ 39g, cảm biến PAW3950MAX"
        },
        {
          "type": "text",
          "id": "url",
          "label": "Link",
          "default": "/collections/chuot-choi-game"
        }
      ]
    }
  ],
  "category": "collection",
  "name": "HADAL danh mục",
  "presets": [
    {
      "name": "HADAL danh mục"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Danh mục"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Tiêu đề",
      "default": "Chọn theo thiết bị"
    },
    {
      "type": "text",
      "id": "tile_cta",
      "label": "Chữ trên mỗi ô",
      "default": "Xem tất cả"
    },
    {
      "type": "header",
      "label": "Style"
    },
    {
      "type": "checkbox",
      "id": "visible",
      "label": "Visible",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "text",
      "id": "padding_top",
      "label": "Padding top (CSS)"
    },
    {
      "type": "text",
      "id": "padding_bottom",
      "label": "Padding bottom (CSS)"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "default": 0,
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "default": 0,
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px"
    }
  ]
}
{% endschema %}
