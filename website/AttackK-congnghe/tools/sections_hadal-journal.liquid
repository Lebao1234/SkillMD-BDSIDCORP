<style>
[data-section-name="hadal-journal"] .hj__head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:26px;flex-wrap:wrap;}
[data-section-name="hadal-journal"] .hj__eyebrow{color:var(--accent);font-family:var(--font-mono);font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;margin:0 0 8px;}
[data-section-name="hadal-journal"] .hj__title{font-family:var(--font-display);font-size:clamp(26px,3.4vw,38px);letter-spacing:-.025em;margin:0;color:var(--ink);}
[data-section-name="hadal-journal"] .hj__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;}
[data-section-name="hadal-journal"] .hj__card{display:flex;flex-direction:column;border:1px solid var(--line-2);border-radius:var(--radius-lg);background:var(--cream);overflow:hidden;transition:border-color .2s ease,transform .2s ease;}
[data-section-name="hadal-journal"] .hj__card:hover{border-color:var(--accent);transform:translateY(-2px);color:var(--ink);}
[data-section-name="hadal-journal"] .hj__card img{width:100%;aspect-ratio:16/10;object-fit:cover;display:block;background:var(--cream-2);}
[data-section-name="hadal-journal"] .hj__body{padding:20px;}
[data-section-name="hadal-journal"] .hj__card b{display:block;font-family:var(--font-display);font-size:17px;line-height:1.3;color:var(--ink);margin-bottom:9px;letter-spacing:-.012em;}
[data-section-name="hadal-journal"] .hj__card p{color:var(--mute);font-size:13.5px;line-height:1.6;margin:0;}
[data-section-name="hadal-journal"] .hj__band{display:grid;grid-template-columns:1.2fr .8fr;gap:34px;align-items:center;border:1px solid var(--line-2);border-radius:var(--radius-lg);background:var(--cream);padding:40px;}
[data-section-name="hadal-journal"] .hj__band p{color:var(--ink-2);font-size:16px;line-height:1.65;margin:0;max-width:54ch;}
[data-section-name="hadal-journal"] .hj__band .hj__act{justify-self:end;}
@media (max-width:900px){
  [data-section-name="hadal-journal"] .hj__grid{grid-template-columns:1fr;}
  [data-section-name="hadal-journal"] .hj__band{grid-template-columns:1fr;gap:22px;padding:28px;}
  [data-section-name="hadal-journal"] .hj__band .hj__act{justify-self:start;}
}
</style>
{%- assign posts = recent_articles -%}
{%- if posts == blank -%}{%- assign posts = articles -%}{%- endif -%}
{%- if posts == blank -%}{%- assign posts = blog.articles -%}{%- endif -%}
<section class="py-section">
  <div class="be-wrap">
    <div class="hj__head">
      <div>
        <p class="hj__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="hj__title">{{ section.settings.heading }}</h2>
      </div>
      {% if posts != blank and section.settings.cta_label != blank %}
        <a class="be-btn be-btn--ghost" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
      {% endif %}
    </div>

    {% if posts != blank %}
      <div class="hj__grid">
        {% for a in posts limit: 3 %}
          <a class="hj__card" href="/blogs/{{ a.slug | default: a.handle }}" data-anim>
            {% if a.featured_image != blank %}<img src="{{ a.featured_image }}" alt="{{ a.title | escape }}" loading="lazy">{% endif %}
            <div class="hj__body">
              <b>{{ a.title }}</b>
              <p>{{ a.excerpt | strip_html | truncate: 120 }}</p>
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="hj__band" data-anim>
        <p>{{ section.settings.sub }}</p>
        <div class="hj__act">
          <a class="be-btn" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "category": "blog",
  "name": "HADAL bài viết",
  "presets": [
    {
      "name": "HADAL bài viết"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Bài viết"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Tiêu đề",
      "default": "Ghi chép từ bàn thử nghiệm"
    },
    {
      "type": "textarea",
      "id": "sub",
      "label": "Mô tả",
      "default": "Chúng tôi đo actuation, polling rate và trọng lượng rồi viết lại đúng những gì máy hiện ra. Không có bài nào được tài trợ."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Nhãn nút",
      "default": "Đọc tất cả bài viết"
    },
    {
      "type": "text",
      "id": "cta_url",
      "label": "Link nút",
      "default": "/blogs"
    },
    {
      "type": "header",
      "label": "Style"
    },
    {
      "type": "checkbox",
      "id": "visible",
      "label": "Visible",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "text",
      "id": "padding_top",
      "label": "Padding top (CSS)"
    },
    {
      "type": "text",
      "id": "padding_bottom",
      "label": "Padding bottom (CSS)"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "default": 0,
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "default": 0,
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px"
    }
  ]
}
{% endschema %}
